# Copy to agents/topup-agent/.env. `npm install` runs at the repository ROOT (npm workspace), then `npm start`.
# Test key from https://codespar.dev/auth/signup (starts with csk_test_). A live key is refused. This agent's pull does not use it.
CODESPAR_API_KEY=csk_test_your_key_here
# https://console.anthropic.com. Leave empty to replay the recorded happy path (the old placeholder sk-ant-your_key_here also counts as empty).
ANTHROPIC_API_KEY=
# Staging only (docs/OPEN_QUESTIONS.md, item 12): a staging test key also needs the staging base URL.
# CODESPAR_API_URL=https://api.staging.codespar.dev

# --- Iniciador sweeping sandbox, for `--rail api`. Commented out and empty on purpose. ---
# Without them the agent runs on its offline fixture. The two credentials come from the vault and
# are best kept OUT of this file: `set -a; . ~/.config/codespar/iniciador-sandbox.env; set +a` in
# the shell that runs the demo. Never paste them in a chat or a commit.
# INICIADOR_CLIENT_ID=
# INICIADOR_CLIENT_SECRET=
# INICIADOR_TEST_TAX_ID=          # 11-digit CPF of the sandbox person, same on both accounts
# INICIADOR_CREDITOR_ID=          # the user-creditor (the person's own account), from POST /sweeping/user-creditors
# INICIADOR_TRIGGER_ID=           # the MANUAL recurring trigger, GET /sweeping/recurring-triggers
# INICIADOR_PARTICIPANT_ID=       # the simulated bank, GET /sweeping/participants
# INICIADOR_TOTAL_CENTS=1000      # authorization totalAllowedAmount AND mandate cap_minor
# INICIADOR_TX_LIMIT_CENTS=500    # authorization transactionLimit AND mandate per_tx_cap_minor
# INICIADOR_BASE_URL=https://consumer.sandbox.inic.dev/v1
# INICIADOR_REDIRECT_URL=

# --- WhatsApp, the official Cloud API backend. Commented out and empty on purpose. ---
# The default backend needs NONE of these: it talks to the local Cloud API emulator
# (`npm run whatsapp:emulator` at the repo root). Uncomment only for `--backend cloud-api`.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_WEBHOOK_PORT=3111
