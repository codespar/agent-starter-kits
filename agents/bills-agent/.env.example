# Copy to agents/bills-agent/.env. `npm install` runs at the repository ROOT (npm workspace), then `npm run consent -- --yes`, then `npm start`.
# Test key from https://dashboard.codespar.dev (starts with csk_test_). A live key is refused.
CODESPAR_API_KEY=csk_test_your_key_here
# https://console.anthropic.com. Leave empty to replay the recorded happy path (the old placeholder sk-ant-your_key_here also counts as empty).
ANTHROPIC_API_KEY=
# Staging only (docs/OPEN_QUESTIONS.md, item 12): a staging test key also needs the staging base URL. A production key needs nothing here.
# CODESPAR_API_URL=https://api.staging.codespar.dev
# Optional: run the model on Gemini instead (https://aistudio.google.com/apikey). Used when ANTHROPIC_API_KEY is empty,
# or explicitly with `npm start -- --provider gemini`. The mandate, guardrails and tools.json do not change with the model.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview   (gemini-2.5-flash is closed to new API keys as of 2026-09-30)
