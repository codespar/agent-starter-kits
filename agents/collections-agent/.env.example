# Test key from https://dashboard.codespar.dev (starts with csk_test_). A live key is refused.
CODESPAR_API_KEY=csk_test_your_key_here
# https://console.anthropic.com. Without it, `npm start` replays the recorded happy-path.
ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- WhatsApp, the official Cloud API backend. Commented out and empty on purpose. ---
# The house simulator needs NONE of these: `npm start -- --channel whatsapp` runs with
# no network and no Meta account, and that is the supported path here. Uncomment them
# only if you have your own Meta Business account and want `--backend cloud-api`. This
# repo has never run one; the shapes are written from Meta's published documentation.
# Nothing in the tests or the CI reads them.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_WEBHOOK_PORT=3111
